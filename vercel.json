{
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/admin.js": { "includeFiles": "private/**" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/:page", "destination": "/api/admin?page=:page" },
    { "source": "/:path", "destination": "/index.html?h=:path" }
  ]
}